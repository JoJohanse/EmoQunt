# EmoQunt 环境变量模板
# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略。

# ===== LLM 模型配置（情绪分析用）=====
API_KEY=your-api-key-here
LLM_MODEL=mimo-v2.5
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_TEMPERATURE=0.75
LLM_MAX_TOKENS=5120
LLM_TIMEOUT=30

# ===== AI 投资助手 Agent 配置（独立于上方情绪分析）=====
# 留空则回退到上方 API_KEY / LLM_BASE_URL
# AGENT_API_KEY=
AGENT_MODEL=mimo-v2.5
# AGENT_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=4096
AGENT_TIMEOUT=60

# ===== TrendRadar 运行控制（可选，留空则回退到 YAML 配置）=====
# REPORT_MODE=daily
# ENABLE_CRAWLER=true
# ENABLE_NOTIFICATION=true

# ===== TrendRadar 推送时间窗（可选）=====
# PUSH_WINDOW_ENABLED=true
# PUSH_WINDOW_START=08:00
# PUSH_WINDOW_END=22:00
# PUSH_WINDOW_ONCE_PER_DAY=true
# PUSH_WINDOW_RETENTION_DAYS=7

# ===== TrendRadar 通知渠道（可选，留空则回退到 YAML 配置）=====
# FEISHU_WEBHOOK_URL=
# DINGTALK_WEBHOOK_URL=
# WEWORK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# EMAIL_FROM=
# EMAIL_PASSWORD=
# EMAIL_TO=
# EMAIL_SMTP_SERVER=
# EMAIL_SMTP_PORT=
# NTFY_SERVER_URL=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=

# ===== 配置文件路径覆盖（可选）=====
# QDT_SENTIMENT_CONFIG_PATH=
# QDT_SCORING_CONFIG_PATH=

# ===== Tushare Pro token（可选，A股数据兜底层；留空则跳过）=====
# 注册地址 https://tushare.pro ；配置后 A 股数据链为 Tushare → akshare → baostock
# TUSHARE_TOKEN=

# ===== 本地数据基础设施（docker compose up -d 启动）=====
# PostgreSQL 持久化缓存（全历史 OHLCV），Redis 热查询缓存。
# 任一设为 false 即静默禁用对应层，自动回退到 CSV + 网络回退链。
POSTGRES_USER=emoqunt
POSTGRES_PASSWORD=emoqunt_local
POSTGRES_DB=emoqunt
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD 留空则无密码；若设置需与 docker-compose.yml 的 REDIS_PASSWORD 保持一致
# REDIS_PASSWORD=
QDT_DB_CACHE_ENABLED=true
QDT_REDIS_CACHE_ENABLED=true
# Redis TTL（保留兼容，实际已改为分层动态：当日 300s / 历史 7d±10% jitter）
# 如需整体覆盖可在代码中改 _TTL_TODAY/_TTL_HISTORY；此处仅作显式开关示例
# QDT_REDIS_TTL_SECONDS=86400

# ===== Docker 国内镜像加速（可选，网络受限时配置）=====
# 1) Docker 镜像源：在 Docker Desktop → Settings → Docker Engine 中加
#    "registry-mirrors": ["https://docker.m.daocloud.io", "https://1ms.run"]
# 2) pip 镜像源：构建时自动使用清华源，也可在宿主机 pip 配置或
#    docker build --build-arg PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ 覆盖
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
