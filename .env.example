# EmoQunt 环境变量模板
# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略。

# ===== LLM 模型配置 =====
API_KEY=your-api-key-here
LLM_MODEL=mimo-v2.5
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_TEMPERATURE=0.75
LLM_MAX_TOKENS=5120
LLM_TIMEOUT=30

# ===== TrendRadar 运行控制（可选，留空则回退到 YAML 配置）=====
# REPORT_MODE=daily
# ENABLE_CRAWLER=true
# ENABLE_NOTIFICATION=true

# ===== TrendRadar 推送时间窗（可选）=====
# PUSH_WINDOW_ENABLED=true
# PUSH_WINDOW_START=08:00
# PUSH_WINDOW_END=22:00
# PUSH_WINDOW_ONCE_PER_DAY=true
# PUSH_WINDOW_RETENTION_DAYS=7

# ===== TrendRadar 通知渠道（可选，留空则回退到 YAML 配置）=====
# FEISHU_WEBHOOK_URL=
# DINGTALK_WEBHOOK_URL=
# WEWORK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# EMAIL_FROM=
# EMAIL_PASSWORD=
# EMAIL_TO=
# EMAIL_SMTP_SERVER=
# EMAIL_SMTP_PORT=
# NTFY_SERVER_URL=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=

# ===== 配置文件路径覆盖（可选）=====
# QDT_SENTIMENT_CONFIG_PATH=
# QDT_SCORING_CONFIG_PATH=
